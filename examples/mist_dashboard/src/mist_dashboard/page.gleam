pub const html = "<!doctype html>
<html lang='en'>
<head>
  <meta charset='utf-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1'>
  <title>Constellation / BEAM Traffic Observatory</title>
  <style>
    :root{--ink:#e8eee9;--muted:#7f9187;--bg:#080c0b;--panel:#101714;--panel2:#0c1210;--line:#29372f;--lime:#c8ff52;--cyan:#43e0c0;--orange:#ff8a5b;--violet:#b7a2ff}
    *{box-sizing:border-box}html{background:var(--bg)}body{margin:0;color:var(--ink);background:radial-gradient(circle at 75% -10%,rgba(67,224,192,.10),transparent 35%),var(--bg);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;min-height:100vh}
    body:before{content:'';position:fixed;inset:0;pointer-events:none;opacity:.22;background:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:32px 32px}
    main{width:min(1240px,calc(100% - 32px));margin:auto;padding:30px 0 54px;position:relative}header{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line);padding-bottom:20px;margin-bottom:18px}
    .eyebrow,.label{color:var(--muted);letter-spacing:.15em;text-transform:uppercase;font-size:10px}.eyebrow{color:var(--lime)}h1{font:400 clamp(34px,5.5vw,68px)/.92 Georgia,serif;letter-spacing:-.05em;margin:8px 0 0}.live{display:flex;align-items:center;gap:9px;border:1px solid var(--line);padding:9px 12px;font-size:10px;text-transform:uppercase;letter-spacing:.08em}.live i{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}.live.pressure{color:var(--orange);border-color:var(--orange)}.live.pressure i{background:var(--orange);box-shadow:0 0 12px var(--orange)}
    .hero{display:grid;grid-template-columns:1.65fr .75fr;gap:1px;background:var(--line);border:1px solid var(--line)}.run-panel,.launch{background:var(--panel);padding:22px}.run-top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.run-count{font-size:clamp(32px,5vw,62px);letter-spacing:-.05em;line-height:1;margin-top:12px}.run-count small{font-size:13px;color:var(--muted);letter-spacing:0}.percent{font:400 36px Georgia,serif;color:var(--lime)}
    .bar{height:9px;background:#070b09;margin-top:22px;position:relative;overflow:hidden}.bar span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--lime));transition:width .18s}.bar.pressure span{background:linear-gradient(90deg,var(--orange),#ffc35b)}.bar-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;margin-top:8px}.launch h2{font:400 19px Georgia,serif;margin:0 0 7px}.launch p{font-size:10px;color:var(--muted);line-height:1.55;margin:0 0 15px}
    button{appearance:none;border:1px solid var(--line);color:var(--ink);background:#16201b;padding:11px 13px;font:inherit;font-size:11px;cursor:pointer;transition:.15s;margin:3px 3px 3px 0}button:hover:not(:disabled){border-color:var(--lime);color:var(--lime);transform:translateY(-1px)}button.primary{width:100%;background:var(--lime);border-color:var(--lime);color:#10150e;font-weight:700;padding:14px}button.stop{width:100%;margin-top:6px;border-color:#59382c;color:var(--orange)}button:disabled{opacity:.35;cursor:not-allowed}
    .metrics{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-top:0}.metric{background:var(--panel2);padding:16px;min-height:100px}.metric strong{display:block;font-size:clamp(20px,2.7vw,34px);font-weight:500;margin-top:15px;letter-spacing:-.04em}.metric.rate strong{color:var(--cyan)}.metric.buffer strong,.metric.retry strong{color:var(--orange)}.unit{font-size:10px;color:var(--muted);margin-left:4px}
    .observatory{display:grid;grid-template-columns:1.55fr .65fr;gap:18px;margin-top:18px}.flow,.chart-card,.activity-card,.events{border:1px solid var(--line);background:var(--panel)}.section-head{display:flex;justify-content:space-between;align-items:center;padding:14px 17px;border-bottom:1px solid var(--line)}.section-head h2{font:400 17px Georgia,serif;margin:0}.section-head span{color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.1em}
    .track{display:grid;grid-template-columns:1fr minmax(72px,.55fr) 1fr minmax(72px,.55fr) 1fr;align-items:center;gap:9px;padding:24px 16px}.node{border:1px solid var(--line);padding:15px 10px;text-align:center;background:#0b110e;transition:.18s;min-width:0}.node.active{border-color:var(--lime);box-shadow:0 0 24px rgba(200,255,82,.13);transform:translateY(-2px)}.node b{display:block;color:var(--lime);font-size:10px;margin-bottom:7px}.node small{display:block;color:var(--muted);font-size:9px;margin-top:6px;overflow-wrap:anywhere}.node .pid{color:var(--cyan);background:#070d0a;padding:4px}.node .work{border-top:1px solid var(--line);padding-top:8px;margin-top:10px;color:var(--ink)}
    .rail{height:58px;position:relative;overflow:hidden}.rail:after{content:'';position:absolute;top:29px;left:0;right:0;border-top:1px dashed var(--muted)}.rail em{position:absolute;z-index:2;font-style:normal;font-size:8px;color:var(--muted)}.rail em:first-of-type{top:5px;left:4px;color:var(--cyan)}.rail em:last-of-type{bottom:3px;right:4px;color:var(--lime)}.packet{position:absolute;z-index:4;top:20px;min-width:24px;height:18px;background:var(--cyan);color:var(--bg);padding:3px 4px;font-size:8px;text-align:center;opacity:0}.rail.forward .packet{animation:right .26s linear}.rail.reverse .packet{background:var(--lime);animation:left .26s linear}@keyframes right{0%{left:-12px;opacity:0}15%,85%{opacity:1}100%{left:calc(100% - 12px);opacity:0}}@keyframes left{0%{right:-12px;opacity:0}15%,85%{opacity:1}100%{right:calc(100% - 12px);opacity:0}}
    .buffer-box{padding:0 17px 17px}.buffer-title{display:flex;justify-content:space-between;font-size:9px;color:var(--muted);margin-bottom:7px}.pulse{animation:pulse .45s ease-out}@keyframes pulse{50%{color:var(--orange);text-shadow:0 0 14px var(--orange)}}
    .chart-card{min-height:275px}.chart-wrap{height:220px;padding:12px 10px 8px}canvas{display:block;width:100%;height:100%}.legend{display:flex;gap:15px;font-size:9px;color:var(--muted)}.legend i{display:inline-block;width:7px;height:7px;margin-right:5px}.legend .in{background:var(--violet)}.legend .out{background:var(--cyan)}
    .lower{display:grid;grid-template-columns:.75fr 1.25fr;gap:18px;margin-top:18px}.controls{padding:14px 17px 17px}.controls p{font-size:10px;color:var(--muted);line-height:1.5}.events{margin-top:18px}.event-list{display:flex;flex-wrap:wrap;gap:6px;padding:16px;min-height:58px}.event{border:1px solid #315048;color:var(--cyan);padding:5px 7px;font-size:10px;animation:arrive .2s ease-out}@keyframes arrive{from{opacity:0;transform:translateY(5px)}}
    .timeline{max-height:280px;overflow:auto}.activity{display:grid;grid-template-columns:68px 1fr auto;gap:11px;padding:10px 16px;border-bottom:1px solid rgba(41,55,47,.65);font-size:10px}.activity .kind{color:var(--lime)}.activity .kind.PRESSURE{color:var(--orange)}.activity .route{color:var(--muted)}.activity .amount{color:var(--cyan)}.empty{color:var(--muted);padding:20px;font-size:10px}footer{display:flex;justify-content:space-between;gap:16px;color:var(--muted);font-size:9px;margin-top:16px}
    @media(max-width:900px){.hero,.observatory,.lower{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(3,1fr)}}
    @media(max-width:620px){main{width:min(100% - 20px,1240px);padding-top:20px}header{align-items:flex-start;flex-direction:column}.metrics{grid-template-columns:1fr 1fr}.track{grid-template-columns:1fr}.rail{height:38px}.node{padding:11px}.run-top{display:block}.percent{margin-top:12px}.activity{grid-template-columns:58px 1fr}.activity .amount{display:none}footer{flex-direction:column}}
  </style>
</head>
<body>
<main>
  <header><div><div class='eyebrow'>Gleam / OTP demand pipeline</div><h1>BEAM Traffic<br>Observatory</h1></div><div class='live' id='status'><i></i><span>actors online</span></div></header>
  <section class='hero'>
    <div class='run-panel'><div class='run-top'><div><div class='label'>processed in current run</div><div class='run-count'><span id='run-processed'>0</span><small> / <span id='run-total'>500,000</span> events</small></div></div><div class='percent' id='progress-text'>0%</div></div><div class='bar'><span id='progress-bar'></span></div><div class='bar-meta'><span id='run-phase'>ready for load</span><span id='run-elapsed'>pure core · OTP transport</span></div></div>
    <div class='launch'><h2>Load generator</h2><p>One click drives synthetic requests through real producer, Stage and consumer actors. Work stays server-side.</p><button class='primary run-button' onclick='startRun(500000)'>RUN 500,000 EVENTS</button><button class='run-button' onclick='startRun(1000000)'>Run 1,000,000</button><button class='stop' id='stop-button' onclick='stopRun()' disabled>Stop run</button></div>
  </section>
  <section class='metrics'>
    <div class='metric'><div class='label'>produced</div><strong id='pushed'>0</strong></div>
    <div class='metric'><div class='label'>processed</div><strong id='received'>0</strong></div>
    <div class='metric rate'><div class='label'>ingress rate</div><strong><span id='push-rate'>0</span><span class='unit'>evt/s</span></strong></div>
    <div class='metric rate'><div class='label'>consumer rate</div><strong><span id='receive-rate'>0</span><span class='unit'>evt/s</span></strong></div>
    <div class='metric buffer'><div class='label'>queued / in flight</div><strong id='buffered'>0</strong></div>
    <div class='metric retry'><div class='label'>backpressure retries</div><strong id='retries'>0</strong></div>
  </section>
  <section class='observatory'>
    <div class='flow'><div class='section-head'><h2>OTP message path</h2><span>3 independent mailboxes</span></div><div class='track'><div class='node' id='producer-process'><b>PRODUCER</b><span>counter-producer</span><small class='pid' id='producer-pid'>loading PID</small><small>generates batches of 10K</small><small class='work'>sent <span id='producer-work'>0</span></small></div><div class='rail' id='producer-rail'><em>PUSH →</em><em></em><i class='packet'>10K</i></div><div class='node' id='stage-process'><b>STAGE</b><span>DemandDispatcher</span><small class='pid' id='stage-pid'>loading PID</small><small>owns demand + FIFO</small><small class='work'>queued <span id='stage-work'>0</span></small></div><div class='rail' id='consumer-rail'><em>DELIVER →</em><em>← DEMAND</em><i class='packet'>5K</i></div><div class='node' id='consumer-process'><b>CONSUMER</b><span>dashboard-consumer</span><small class='pid' id='consumer-pid'>loading PID</small><small>requests batches of 5K</small><small class='work'>handled <span id='consumer-work'>0</span></small></div></div><div class='buffer-box'><div class='buffer-title'><span>STAGE BUFFER PRESSURE</span><span id='buffer-label'>0 / 80,000</span></div><div class='bar pressure'><span id='buffer-bar'></span></div></div></div>
    <div class='chart-card'><div class='section-head'><h2>Live throughput</h2><div class='legend'><span><i class='in'></i>in</span><span><i class='out'></i>out</span></div></div><div class='chart-wrap'><canvas id='chart'></canvas></div></div>
  </section>
  <section class='lower'>
    <div><div class='flow'><div class='section-head'><h2>Manual protocol</h2><span>disabled during run</span></div><div class='controls'><button class='manual' onclick='act(&apos;push&apos;,5000)'>Push 5K</button><button class='manual' onclick='act(&apos;ask&apos;,5000)'>Demand 5K</button><button class='manual' onclick='act(&apos;push&apos;,50000)'>Push 50K</button><p>Use these to inspect demand and buffering one command at a time.</p></div></div><div class='events'><div class='section-head'><h2>Latest event IDs</h2><span>sample only</span></div><div class='event-list' id='event-list'></div></div></div>
    <div class='activity-card'><div class='section-head'><h2>Protocol activity</h2><span>aggregated batches</span></div><div class='timeline' id='timeline'><div class='empty'>Start a run to observe the protocol.</div></div></div>
  </section>
  <footer><span>constellation · pure functional core + generic runtime + OTP adapter</span><span>UI polls aggregate state only · no event-per-node rendering</span></footer>
</main>
<script>
const fmt=new Intl.NumberFormat();
let renderedRevision=-1,refreshing=false,acting=false,latest=null,lastSample=null;
let pushRate=0,receiveRate=0,lastAnimated=0,animating=false;
const animationQueue=[],observedAt=new Map(),inPoints=[],outPoints=[];
function displayPid(pid){return pid.startsWith('//erl(')?pid.slice(6,-1):pid}
function queueActivity(a){if(animationQueue.length>2)animationQueue.shift();animationQueue.push(a);runAnimation()}
function runAnimation(){if(animating||!animationQueue.length)return;animating=true;animate(animationQueue.shift())}
function animate(a){const c={PUSH:['producer-rail','forward','producer-process','stage-process'],DEMAND:['consumer-rail','reverse','consumer-process','stage-process'],DELIVER:['consumer-rail','forward','stage-process','consumer-process']}[a.kind];if(!c){animating=false;runAnimation();return}const [railId,direction,fromId,toId]=c,rail=document.getElementById(railId);rail.querySelector('.packet').textContent=compact(a.amount);rail.classList.remove('forward','reverse');void rail.offsetWidth;rail.classList.add(direction);document.getElementById(fromId).classList.add('active');document.getElementById(toId).classList.add('active');setTimeout(()=>{rail.classList.remove(direction);document.getElementById(fromId).classList.remove('active');document.getElementById(toId).classList.remove('active');animating=false;runAnimation()},290)}
function compact(n){return n>=1000000?(n/1000000).toFixed(1)+'M':n>=1000?Math.round(n/1000)+'K':String(n)}
function updateRates(s){const now=performance.now();if(lastSample){const seconds=(now-lastSample.time)/1000;if(seconds>.05){const inNow=Math.max(0,(s.pushed-lastSample.pushed)/seconds),outNow=Math.max(0,(s.received-lastSample.received)/seconds);pushRate=pushRate*.62+inNow*.38;receiveRate=receiveRate*.62+outNow*.38}}lastSample={time:now,pushed:s.pushed,received:s.received};if(!s.running&&s.run_total&&s.run_received>=s.run_total){pushRate*=.72;receiveRate*=.72}inPoints.push(pushRate);outPoints.push(receiveRate);if(inPoints.length>70){inPoints.shift();outPoints.shift()}drawChart()}
function drawChart(){const canvas=document.getElementById('chart'),box=canvas.getBoundingClientRect(),dpr=devicePixelRatio||1,w=Math.max(1,box.width),h=Math.max(1,box.height);if(canvas.width!==Math.round(w*dpr)||canvas.height!==Math.round(h*dpr)){canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr)}const ctx=canvas.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,w,h);ctx.strokeStyle='#26342d';ctx.lineWidth=1;for(let y=0;y<=4;y++){ctx.beginPath();ctx.moveTo(0,y*h/4+.5);ctx.lineTo(w,y*h/4+.5);ctx.stroke()}const max=Math.max(1,...inPoints,...outPoints);function line(points,color){ctx.beginPath();points.forEach((v,i)=>{const x=points.length<2?0:i*w/(points.length-1),y=h-8-(v/max)*(h-18);i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.strokeStyle=color;ctx.lineWidth=2;ctx.stroke()}line(inPoints,'#b7a2ff');line(outPoints,'#43e0c0')}
function render(s){if(s.revision<renderedRevision)return;renderedRevision=s.revision;latest=s;updateRates(s);for(const k of ['pushed','received','buffered'])document.getElementById(k).textContent=fmt.format(s[k]);document.getElementById('push-rate').textContent=fmt.format(Math.round(pushRate));document.getElementById('receive-rate').textContent=fmt.format(Math.round(receiveRate));document.getElementById('retries').textContent=fmt.format(s.rejected_pushes);document.getElementById('run-processed').textContent=fmt.format(s.run_received);document.getElementById('run-total').textContent=fmt.format(s.run_total||500000);const progress=s.run_total?Math.min(100,s.run_received/s.run_total*100):0,pressure=Math.min(100,s.buffered/s.buffer_capacity*100);document.getElementById('progress-text').textContent=progress.toFixed(progress<10?1:0)+'%';document.getElementById('progress-bar').style.width=progress+'%';document.getElementById('buffer-bar').style.width=pressure+'%';document.getElementById('buffer-label').textContent=fmt.format(s.buffered)+' / '+fmt.format(s.buffer_capacity);document.getElementById('run-phase').textContent=s.running?(s.backpressured?'backpressure active · producer retrying':'processing across OTP actors'):(s.run_total&&s.run_received>=s.run_total?'run complete':'ready for load');const status=document.getElementById('status');status.classList.toggle('pressure',s.backpressured);status.querySelector('span').textContent=s.backpressured?'backpressure active':s.running?'pipeline running':'actors online';document.querySelectorAll('.run-button,.manual').forEach(b=>b.disabled=s.running);document.getElementById('stop-button').disabled=!s.running;document.getElementById('producer-pid').textContent=displayPid(s.producer_pid);document.getElementById('stage-pid').textContent=displayPid(s.stage_pid);document.getElementById('consumer-pid').textContent=displayPid(s.consumer_pid);document.getElementById('producer-work').textContent=fmt.format(s.pushed);document.getElementById('stage-work').textContent=fmt.format(s.buffered);document.getElementById('consumer-work').textContent=fmt.format(s.received);document.getElementById('event-list').innerHTML=s.last_events.map(x=>`<span class='event'>#${fmt.format(x)}</span>`).join('');for(const a of s.activities)if(!observedAt.has(a.sequence))observedAt.set(a.sequence,new Date().toLocaleTimeString());document.getElementById('timeline').innerHTML=s.activities.length?s.activities.map(a=>`<div class='activity'><span class='kind ${a.kind}'>${a.kind}</span><span class='route'>${a.source} → ${a.target}</span><span class='amount'>${fmt.format(a.amount)}</span></div>`).join(''):`<div class='empty'>Start a run to observe the protocol.</div>`;const newest=s.activities[0];if(lastAnimated)s.activities.filter(a=>a.sequence>lastAnimated).slice(0,3).reverse().forEach(queueActivity);if(newest)lastAnimated=Math.max(lastAnimated,newest.sequence);if(s.backpressured){const el=document.getElementById('buffered');el.classList.remove('pulse');void el.offsetWidth;el.classList.add('pulse')}}
async function refresh(){if(refreshing)return;refreshing=true;try{const r=await fetch('/api/state',{cache:'no-store'});if(!r.ok)throw new Error('state unavailable');render(await r.json())}catch(e){document.querySelector('#status span').textContent='disconnected'}finally{refreshing=false}}
async function request(path){if(acting)return false;acting=true;try{const r=await fetch(path,{method:'POST',cache:'no-store'});if(!r.ok)throw new Error(await r.text());render(await r.json());return true}catch(e){document.querySelector('#status span').textContent=e.message;return false}finally{acting=false}}
function act(kind,n){return request(`/api/${kind}/${n}`)}function startRun(total){return request(`/api/run/${total}`)}function stopRun(){return request('/api/run/stop')}
addEventListener('resize',drawChart);setInterval(refresh,150);refresh();
</script>
</body>
</html>"
